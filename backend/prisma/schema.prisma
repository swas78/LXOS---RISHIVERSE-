// RishiVerse module scaffold — Prisma schema ROOT.
//
// This directory is a MULTI-FILE Prisma schema (Prisma >= 6). This file holds
// only the generator + datasource; every model lives under `prisma/models/`:
//
//   prisma/models/demo/*.prisma   scaffold sample
//   prisma/models/lx/*.prisma     LX (Learner Experience OS) module
//
// This mirrors how RishiVerse-Backend composes its schema (`schema: 'prisma'`
// in prisma.config.ts), so handoff is a directory copy of `prisma/models/lx/`
// with no edits to core's root schema.
//
// NOTE FOR RISHIVERSE MAINTAINERS
// ------------------------------
// Core's root schema.prisma omits `url` (it is supplied by prisma.config.ts).
// After copying `prisma/models/lx/`, follow core's datasource block and run
// `npx prisma generate` only — do NOT run `migrate dev` / `db push`.
// Maintainers author and apply the migration.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
