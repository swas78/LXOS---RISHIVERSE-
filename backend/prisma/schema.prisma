generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// DEMO MODULE — canonical scaffold sample. Copy this pattern for real modules.
// ---------------------------------------------------------------------------

model DemoItem {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      DemoItemStatus @default(DRAFT)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([deletedAt])
  @@map("demo_items")
}

enum DemoItemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ===========================================================================
// LX MODULE (Learner Experience OS)
//
// Ported from the original LXOS (Next.js + MongoDB). Composed here in the kit's
// single schema; at handoff these live under prisma/models/lx/*.prisma.
//
// AUTH / USERS: This kit ships no auth. `LxUser` is a LOCAL DEV STAND-IN for the
// RishiVerse core `User` (which we must NOT redefine). At integration, the
// dev-actor shim + this table are dropped and `*CreatedById` / actor references
// map onto core `User.userId`. Creator/approver names are DENORMALIZED onto rows
// (snapshotted at write time) so reads need no join to the user table.
// ===========================================================================

enum LxRole {
  ADMIN
  LX_TEAM
  CLUB_HEAD
  CLAN_HEAD
  FINANCE
  GUEST
}

// LOCAL DEV STAND-IN — not part of handoff. Powers the role/user switcher.
model LxUser {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      LxRole   @default(GUEST)
  clubId    String?
  clanId    String?
  avatar    String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@map("lx_users")
}

// --------------------------- Rooms -----------------------------------------

model LxRoom {
  id         String     @id @default(cuid())
  name       String
  building   String?
  floor      String?
  capacity   Int        @default(0)
  type       LxRoomType @default(CLASSROOM)
  amenities  String[]   @default([])
  isActive   Boolean    @default(true)
  deletedAt  DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  bookings LxRoomBooking[]

  @@index([deletedAt])
  @@index([type])
  @@map("lx_rooms")
}

enum LxRoomType {
  CLASSROOM
  SEMINAR
  LAB
  AUDITORIUM
  MEETING
  STUDIO
  OUTDOOR
  OTHER
}

// --------------------------- Clubs -----------------------------------------

model LxClub {
  id              String          @id @default(cuid())
  name            String          @unique
  description     String
  logo            String?
  category        LxClubCategory  @default(OTHER)
  budgetAllocated Float           @default(0)
  budgetSpent     Float           @default(0)
  semester        String          @default("Spring 2026")
  budgetHistory   Json            @default("[]")
  headName        String?
  headEmail       String?
  isActive        Boolean         @default(true)
  deletedAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([deletedAt])
  @@index([category])
  @@map("lx_clubs")
}

enum LxClubCategory {
  TECHNICAL
  CULTURAL
  SPORTS
  SOCIAL
  ACADEMIC
  OTHER
}

// --------------------------- Clans -----------------------------------------

model LxClan {
  id              String    @id @default(cuid())
  name            String    @unique
  color           String
  points          Int       @default(0)
  budgetAllocated Float     @default(0)
  budgetSpent     Float     @default(0)
  semester        String    @default("Spring 2026")
  budgetHistory   Json      @default("[]")
  description     String    @default("")
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pointTxns LxClanPointTxn[]

  @@index([deletedAt])
  @@map("lx_clans")
}

// Append-only ledger of clan point transactions (per PRD: LxClanPointTxn).
// Each row records a delta and the resulting balance; rows are never updated
// or deleted — corrections are made by posting a compensating transaction.
model LxClanPointTxn {
  id             String   @id @default(cuid())
  clanId         String
  delta          Int
  points         Int
  previousPoints Int
  reason         String
  eventId        String?
  createdById    String?
  createdByName  String?
  date           DateTime @default(now())
  createdAt      DateTime @default(now())

  clan LxClan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId])
  @@map("lx_clan_point_txns")
}

// --------------------------- Events ----------------------------------------

model LxEvent {
  id              String        @id @default(cuid())
  title           String
  description     String
  type            LxEventType
  clubId          String?
  clubName        String?
  clanId          String?
  clanName        String?
  startDate       DateTime
  endDate         DateTime
  roomIds         String[]      @default([])
  roomNames       String[]      @default([])
  location        String        @default("")
  requirements    Json          @default("[]")
  budgetAllocated Float         @default(0)
  budgetSpent     Float         @default(0)
  status          LxEventStatus @default(PENDING)
  createdById     String
  createdByName   String
  createdByRole   String?
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?
  attendees       Int           @default(0)
  poster          String?
  clanScores      Json          @default("{}")
  isCompleted     Boolean       @default(false)
  completedAt     DateTime?
  completedById   String?
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([deletedAt])
  @@index([startDate, endDate])
  @@index([type, status])
  @@map("lx_events")
}

enum LxEventType {
  CLUB
  CLAN
  LX
  FEST
}

enum LxEventStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

// --------------------------- Achievements ----------------------------------

model LxAchievement {
  id              String                 @id @default(cuid())
  title           String
  description     String
  eventId         String?
  clubId          String?
  clubName        String?
  clanId          String?
  clanName        String?
  points          Int                    @default(0)
  achievedDate    DateTime               @default(now())
  semester        String                 @default("Spring 2026")
  category        LxAchievementCategory  @default(OTHER)
  kind            LxAchievementKind      @default(ACHIEVEMENT)
  participants    String[]               @default([])
  images          String[]               @default([])
  createdById     String
  createdByName   String
  status          LxAchievementStatus    @default(PENDING)
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?
  deletedAt       DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([deletedAt])
  @@index([status, achievedDate])
  @@index([semester, category])
  @@map("lx_achievements")
}

enum LxAchievementCategory {
  ACADEMIC
  SPORTS
  CULTURAL
  TECHNICAL
  SOCIAL
  OTHER
}

enum LxAchievementKind {
  ACHIEVEMENT
  UPDATE
}

enum LxAchievementStatus {
  PENDING
  APPROVED
  REJECTED
}

// --------------------------- Expenses (event spend) ------------------------

model LxExpense {
  id              String           @id @default(cuid())
  eventId         String
  eventTitle      String?
  title           String
  description     String           @default("")
  amount          Float
  category        LxExpenseCategory @default(OTHER)
  bills           Json             @default("[]")
  submittedById   String
  submittedByName String
  status          LxExpenseStatus  @default(PENDING)
  verifiedById    String?
  verifiedByName  String?
  verifiedAt      DateTime?
  rejectionReason String?
  paidDate        DateTime?
  budgetApplied   Boolean          @default(false)
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([deletedAt])
  @@index([eventId, status])
  @@index([category])
  @@map("lx_expenses")
}

enum LxExpenseCategory {
  VENUE
  FOOD
  EQUIPMENT
  DECORATION
  PRIZES
  MARKETING
  OTHER
}

enum LxExpenseStatus {
  PENDING
  APPROVED
  REJECTED
}

// --------------------------- Reimbursements --------------------------------

model LxReimbursement {
  id              String                  @id @default(cuid())
  title           String
  description     String                  @default("")
  amount          Float
  expenseDate     DateTime
  category        LxReimbursementCategory @default(OTHER)
  eventId         String?
  eventTitle      String?
  purpose         String                  @default("")
  clubId          String?
  clubName        String?
  clanId          String?
  clanName        String?
  budgetDeducted  Boolean                 @default(false)
  // Where to send the payout — the submitter provides these at submission time
  // (accountHolderName, accountNumber, ifsc). NOTE: in production this is
  // sensitive data; RishiVerse should encrypt at rest / apply its data policy.
  bankDetails     Json                    @default("{}")
  // The finance/UPI/bank-transfer reference captured by Finance when the
  // (already-approved) claim is actually paid out.
  payoutRef       String?
  bills           Json                    @default("[]")
  submittedById   String
  submittedByName String
  status          LxReimbursementStatus   @default(PENDING)
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  processedById   String?
  processedByName String?
  processedAt     DateTime?
  rejectionReason String?
  notes           String?
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([deletedAt])
  @@index([submittedById, status])
  @@index([status, createdAt])
  @@map("lx_reimbursements")
}

enum LxReimbursementCategory {
  FOOD
  TRAVEL
  MATERIALS
  EQUIPMENT
  PRINTING
  ACCOMMODATION
  OTHER
}

enum LxReimbursementStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

// --------------------------- Initiatives (clan projects) -------------------

model LxInitiative {
  id            String             @id @default(cuid())
  title         String
  description   String             @default("")
  clanId        String
  clanName      String?
  semester      String             @default("")
  status        LxInitiativeStatus @default(ACTIVE)
  progress      Int                @default(0)
  priority      String             @default("MEDIUM")
  team          String[]           @default([])
  date          DateTime           @default(now())
  createdById   String?
  createdByName String?
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([deletedAt])
  @@index([clanId, semester])
  @@map("lx_initiatives")
}

enum LxInitiativeStatus {
  PLANNING
  ACTIVE
  COMPLETED
}

// --------------------------- Files -----------------------------------------

model LxFile {
  id             String     @id @default(cuid())
  filename       String
  originalName   String
  path           String
  mimeType       String
  size           Int
  type           LxFileType @default(OTHER)
  eventId        String?
  clubId         String?
  semester       String     @default("Spring 2026")
  tags           String[]   @default([])
  description    String?
  uploadedById   String
  uploadedByName String
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([deletedAt])
  @@index([type, semester])
  @@map("lx_files")
}

enum LxFileType {
  BILL
  REPORT
  POSTER
  DOCUMENT
  OTHER
}

// --------------------------- Learner Products ------------------------------
// Products / websites built by learners. Only APPROVED products are shown
// publicly in the showcase; PENDING ones await Admin review.

model LxProduct {
  id              String            @id @default(cuid())
  title           String
  tagline         String            @default("")
  description     String
  url             String?
  repoUrl         String?
  imageUrl        String?
  category        LxProductCategory @default(WEBSITE)
  techStack       String[]          @default([])
  tags            String[]          @default([])
  clubId          String?
  clubName        String?
  featured        Boolean           @default(false)
  createdById     String
  createdByName   String
  teamMembers     String[]          @default([])
  status          LxProductStatus   @default(PENDING)
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?
  deletedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([deletedAt])
  @@index([status, createdAt])
  @@index([category])
  @@map("lx_products")
}

enum LxProductCategory {
  WEBSITE
  WEB_APP
  MOBILE_APP
  HARDWARE
  DESIGN
  RESEARCH
  GAME
  OTHER
}

enum LxProductStatus {
  PENDING
  APPROVED
  REJECTED
}

// --------------------------- Room Bookings ---------------------------------
// A time-bounded reservation of a single room. Bookings are the source of
// truth for room availability / double-booking prevention. An event may spawn
// one booking per room it occupies (eventId links them); ad-hoc bookings have
// no event. Conflict detection: no two non-cancelled/non-rejected bookings for
// the same room may overlap in time.

model LxRoomBooking {
  id              String              @id @default(cuid())
  roomId          String
  roomName        String?
  eventId         String?
  eventTitle      String?
  title           String
  purpose         String              @default("")
  startTime       DateTime
  endTime         DateTime
  status          LxRoomBookingStatus @default(PENDING)
  requestedById   String
  requestedByName String
  approvedById    String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?
  deletedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  room LxRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([deletedAt])
  @@index([roomId, startTime, endTime])
  @@index([status])
  @@map("lx_room_bookings")
}

enum LxRoomBookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
