// ===========================================================================
// LX MODULE — Rooms
//
// COLLISION NOTE (lxos-core-pack/collisions.md)
// ---------------------------------------------
// Core already owns `Building → Floor → Room → RoomBooking` behind the
// "Book Venue" product. That is a DIFFERENT inventory (hostel/classroom stock)
// from LX event space. These tables coexist; LXOS must never write to core's
// `RoomBooking`. The `Lx` prefix and `lx_` table mapping are mandatory.
// ===========================================================================

model LxRoom {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  building  String?
  floor     String?
  capacity  Int        @default(0)
  type      LxRoomType @default(CLASSROOM)
  amenities String[]   @default([])
  isActive  Boolean    @default(true)
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @default(now()) @updatedAt
  /// Core `User.userId` of whoever last changed this row. Core stamps this on
  /// every domain table; it is an Int because core's User PK is an Int, unlike
  /// the `*ByRef` columns which carry `User.referenceId`.
  updatedBy Int?

  bookings LxRoomBooking[]

  @@index([deletedAt])
  @@index([type])
  @@map("lx_rooms")
}

enum LxRoomType {
  CLASSROOM
  SEMINAR
  LAB
  AUDITORIUM
  MEETING
  STUDIO
  OUTDOOR
  OTHER
}
