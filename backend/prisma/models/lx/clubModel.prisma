// ===========================================================================
// LX MODULE — Clubs
//
// COLLISION NOTE — DECISION D1 IS SETTLED: COEXIST (confirmed by maintainers)
// ------------------------------------------------------------------------
// Core already ships a student Clubs product: models `Club` / `ClubEvent` /
// `ClubMember`, routes `/api/v1/club`, UI at `/clubs`. Core `Club.id` is an
// autoincrement Int; LX ids are uuids (`gen_random_uuid()`, `@db.Uuid`).
//
// This module takes option 2, COEXIST: `LxClub` models Learner
// Experience orgs with budgets and semesters — a different product from core's
// club directory and membership requests. Routes stay under `/api/v1/lx/club`
// (never `/club`) and the Redux key is `lxClub` (never `clubs`).
//
// If maintainers instead choose option 1, DEFER, this model is dropped and LX
// rows point at core clubs via `coreClubId Int?`. To keep that migration cheap,
// nothing outside this module should assume `LxClub` exists — the club id is
// carried as an opaque string everywhere else.
// ===========================================================================

model LxClub {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Unique among LIVE rows only. Postgres cannot express that as a column
  /// constraint, so this is NOT `@unique`: a plain unique index would keep a
  /// soft-deleted row's name reserved for ever, and a new row could never
  /// reuse it. The maintainer migration must add the partial index:
  ///   CREATE UNIQUE INDEX lx_rows_name_live_key
  ///     ON lx_rows (name) WHERE deleted_at IS NULL;
  /// Until then the guarantee is enforced in the DAL inside a transaction.
  name        String
  description String
  logo        String?
  category    LxClubCategory @default(OTHER)

  /// Per-semester budget. Rolled over by `services/lx/reportService.js`, which
  /// archives the closing figures into `budgetHistory` and resets `budgetSpent`.
  budgetAllocated Decimal  @default(0) @db.Decimal(12, 2)
  budgetSpent     Decimal  @default(0) @db.Decimal(12, 2)
  semester        String @default("Spring 2026")
  /// Array of { semester, budgetAllocated, budgetSpent, closedAt } snapshots.
  budgetHistory   Json   @default("[]")

  /// Core `User.referenceId` of the club head, if one is assigned.
  headRef   String?
  /// CACHE — may drift. Resolve from core User/Student/Employee at read.
  headName  String?
  /// CACHE — may drift. Core `User.emailId` is the source of truth.
  headEmail String?

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  /// Core `User.userId` of whoever last changed this row. Core stamps this on
  /// every domain table; it is an Int because core's User PK is an Int, unlike
  /// the `*ByRef` columns which carry `User.referenceId`.
  updatedBy Int?

  events         LxEvent[]
  achievements   LxAchievement[]
  files          LxFile[]
  products       LxProduct[]
  reimbursements LxReimbursement[]
  members        LxMember[]

  @@index([deletedAt])
  @@index([category])
  @@index([name])
  @@map("lx_clubs")
}

enum LxClubCategory {
  TECHNICAL
  CULTURAL
  SPORTS
  SOCIAL
  ACADEMIC
  OTHER
}
