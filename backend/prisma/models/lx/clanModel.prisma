// ===========================================================================
// LX MODULE — Clans + the clan point ledger
//
// Clans are the inter-house competition structure (Maratha, Vijaya, Chola,
// Rajputana). They have no core equivalent, so there is no collision here.
// ===========================================================================

model LxClan {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String @unique
  /// Hex brand colour, e.g. "#f97316". Rendered inline (not a design token)
  /// because it is per-clan data, not part of the theme.
  color       String
  description String @default("")

  /// Denormalised running balance. The append-only ledger in LxClanPointTxn is
  /// the source of truth; this column is a materialised total kept in step
  /// inside the same transaction that writes the txn.
  points Int @default(0)

  budgetAllocated Float  @default(0)
  budgetSpent     Float  @default(0)
  semester        String @default("Spring 2026")
  /// Array of { semester, budgetAllocated, budgetSpent, points, closedAt }.
  budgetHistory   Json   @default("[]")

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  /// Core `User.userId` of whoever last changed this row. Core stamps this on
  /// every domain table; it is an Int because core's User PK is an Int, unlike
  /// the `*ByRef` columns which carry `User.referenceId`.
  updatedBy Int?

  pointTxns      LxClanPointTxn[]
  events         LxEvent[]
  achievements   LxAchievement[]
  initiatives    LxInitiative[]
  reimbursements LxReimbursement[]
  members        LxMember[]

  @@index([deletedAt])
  @@map("lx_clans")
}

/// Append-only ledger of clan point movements. Rows are NEVER updated or
/// deleted — a mistake is corrected by posting a compensating transaction, so
/// the history stays auditable. There is deliberately no `deletedAt` here.
model LxClanPointTxn {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  clanId String @db.Uuid
  /// Signed movement. Negative deducts.
  delta          Int
  /// Balance AFTER this txn was applied.
  points         Int
  /// Balance BEFORE this txn was applied.
  previousPoints Int
  reason         String
  eventId String? @db.Uuid

  /// Core `User.referenceId` of the admin who posted the adjustment.
  createdByRef  String?
  /// CACHE — may drift. Resolve from core User/Student/Employee at read.
  createdByName String?

  date      DateTime @default(now())
  createdAt DateTime @default(now())

  clan LxClan @relation(fields: [clanId], references: [id], onDelete: Cascade)

  @@index([clanId])
  @@map("lx_clan_point_txns")
}
