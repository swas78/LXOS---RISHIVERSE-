// DEMO MODULE — canonical scaffold sample. Copy this pattern for real modules.
// This file is part of the multi-file schema rooted at prisma/schema.prisma.

model DemoItem {
  id          String         @id @default(cuid())
  title       String
  description String?
  status      DemoItemStatus @default(DRAFT)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([deletedAt])
  @@map("demo_items")
}

enum DemoItemStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}
