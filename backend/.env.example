# Copy this file to .env and fill in the values. Never commit real secrets.
PORT=3010

# PostgreSQL connection string — RishiVerse: add your database URL here.
# Example: postgresql://<user>:<password>@<host>:5432/<database>?schema=public
DATABASE_URL=""

# Local dev only: origin allowed by the dev CORS shim (default "*").
# CORS_ORIGIN=http://localhost:3020

# ⚠️ D3 VIOLATION WHEN TRUE — LEAVE FALSE AT HANDOFF.
# Lets the LX reimbursement form collect a raw account number / IFSC so the
# standalone kit can be demoed with no core `Student` row to read bank details
# from. Core forbids plaintext bank columns in `lx_` tables: a claim stores only
# `payoutRef` ("student-bank:<enrollmentNo>") and Finance resolves the account
# from the student profile. See lxos-core-pack/payouts.md.
# Keep in sync with the frontend's NEXT_PUBLIC_LX_COLLECT_BANK.
LX_COLLECT_BANK=false
